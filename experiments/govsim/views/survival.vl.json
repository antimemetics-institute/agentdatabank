{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "GovSim: completed-run outcomes by model and exact recorded condition. Individual observations, median, interquartile range, and normalized density for n \u2265 5.",
  "data": {
    "name": "runs"
  },
  "facet": {
    "row": {
      "field": "model_label",
      "type": "nominal",
      "title": "Model",
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelOrient": "left",
        "labelFontSize": 12,
        "labelLimit": 0,
        "labelPadding": 16,
        "titleFontSize": 13,
        "titlePadding": 20
      },
      "sort": {
        "field": "group",
        "order": "ascending"
      }
    }
  },
  "spec": {
    "width": "container",
    "height": 76,
    "layer": [
      {
        "transform": [
          {
            "filter": "datum.samples >= 5 && datum.maximum > datum.minimum"
          },
          {
            "density": "outcome",
            "groupby": [
              "param_model",
              "model_label"
            ],
            "as": [
              "outcome",
              "density"
            ],
            "resolve": "independent",
            "steps": 100
          },
          {
            "joinaggregate": [
              {
                "op": "max",
                "field": "density",
                "as": "peak"
              }
            ],
            "groupby": [
              "param_model"
            ]
          },
          {
            "calculate": "datum.density / datum.peak",
            "as": "upper"
          },
          {
            "calculate": "-datum.upper",
            "as": "lower"
          }
        ],
        "mark": {
          "type": "area",
          "orient": "vertical",
          "opacity": 0.25,
          "clip": true
        },
        "encoding": {
          "y": {
            "field": "upper",
            "type": "quantitative",
            "scale": {
              "domain": [
                -1.1,
                1.1
              ]
            },
            "axis": null
          },
          "y2": {
            "field": "lower"
          },
          "color": {
            "field": "param_model",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": {
                "expr": "modelDomain"
              },
              "scheme": "tableau10"
            }
          }
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "max",
                "field": "median",
                "as": "median"
              },
              {
                "op": "max",
                "field": "q1",
                "as": "q1"
              },
              {
                "op": "max",
                "field": "q3",
                "as": "q3"
              },
              {
                "op": "max",
                "field": "samples",
                "as": "samples"
              }
            ],
            "groupby": [
              "model_label"
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeWidth": 5,
          "style": "summary-interval"
        },
        "encoding": {
          "x": {
            "field": "q1",
            "type": "quantitative"
          },
          "x2": {
            "field": "q3"
          },
          "y": {
            "datum": 0,
            "type": "quantitative",
            "axis": null
          }
        }
      },
      {
        "mark": {
          "type": "circle",
          "size": 48,
          "opacity": 0.85,
          "strokeWidth": 0.5,
          "style": "observation"
        },
        "encoding": {
          "y": {
            "field": "jitter",
            "type": "quantitative",
            "axis": null
          },
          "tooltip": [
            {
              "field": "param_model",
              "title": "Model"
            },
            {
              "field": "samples",
              "title": "Completed runs in group"
            },
            {
              "field": "outcome",
              "title": "Outcome",
              "format": ".4~g"
            },
            {
              "field": "run",
              "title": "Run"
            },
            {
              "field": "condition",
              "title": "Condition"
            },
            {
              "field": "param_experiment",
              "title": "Scenario / treatment"
            },
            {
              "field": "param_max_rounds",
              "title": "Round limit (0 = full)"
            },
            {
              "field": "param_embedder",
              "title": "Memory embedder"
            },
            {
              "field": "seed",
              "title": "Seed"
            },
            {
              "field": "result_collapsed",
              "title": "Collapsed"
            },
            {
              "field": "median",
              "title": "Group median",
              "format": ".3~g"
            },
            {
              "field": "q1",
              "title": "25th percentile",
              "format": ".3~g"
            },
            {
              "field": "q3",
              "title": "75th percentile",
              "format": ".3~g"
            }
          ],
          "color": {
            "field": "param_model",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": {
                "expr": "modelDomain"
              },
              "scheme": "tableau10"
            }
          }
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "max",
                "field": "median",
                "as": "median"
              },
              {
                "op": "max",
                "field": "q1",
                "as": "q1"
              },
              {
                "op": "max",
                "field": "q3",
                "as": "q3"
              },
              {
                "op": "max",
                "field": "samples",
                "as": "samples"
              }
            ],
            "groupby": [
              "model_label"
            ]
          }
        ],
        "mark": {
          "type": "point",
          "shape": "diamond",
          "size": 85,
          "filled": true,
          "strokeWidth": 2,
          "style": "summary-median"
        },
        "encoding": {
          "x": {
            "field": "median",
            "type": "quantitative"
          },
          "y": {
            "datum": 0,
            "type": "quantitative",
            "axis": null
          },
          "tooltip": [
            {
              "field": "median",
              "title": "Median",
              "format": ".4~g"
            },
            {
              "field": "q1",
              "title": "Q1",
              "format": ".4~g"
            },
            {
              "field": "q3",
              "title": "Q3",
              "format": ".4~g"
            },
            {
              "field": "samples",
              "title": "Plotted runs"
            }
          ]
        }
      }
    ],
    "encoding": {
      "x": {
        "field": "outcome",
        "type": "quantitative",
        "scale": {
          "zero": true
        },
        "axis": {
          "tickCount": 6,
          "title": {
            "expr": "outcomeAxis"
          },
          "titleFontSize": 13,
          "titlePadding": 16,
          "labelFontSize": 12,
          "gridOpacity": 0.3,
          "labelFlush": false
        }
      }
    }
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "facet": {
      "spacing": 6
    },
    "view": {
      "stroke": null
    }
  }
}
