{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Equality and yield for completed runs. Drag over points to highlight the corresponding runs in the resource chart below.",
  "data": {
    "name": "runs"
  },
  "transform": [
    {
      "filter": "datum.state === 'completed'"
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 240,
      "params": [
        {
          "name": "chosen",
          "select": {
            "type": "interval"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 110
      },
      "encoding": {
        "x": {
          "field": "result_equality",
          "type": "quantitative",
          "title": "Harvest equality (1 = equal)",
          "scale": {
            "domain": [
              0,
              1.05
            ]
          },
          "axis": {
            "tickCount": 5
          }
        },
        "y": {
          "field": "result_gain_per_agent",
          "type": "quantitative",
          "title": "Mean collected per agent",
          "scale": {
            "zero": true
          },
          "axis": {
            "tickCount": 5
          }
        },
        "color": {
          "field": "param_model",
          "type": "nominal",
          "title": "Model"
        },
        "opacity": {
          "condition": {
            "param": "chosen",
            "value": 0.85
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "run",
            "title": "Run"
          },
          {
            "field": "condition",
            "title": "Condition"
          },
          {
            "field": "param_experiment",
            "title": "Scenario"
          },
          {
            "field": "result_equality",
            "title": "Equality"
          },
          {
            "field": "result_gain_per_agent",
            "title": "Mean collected"
          }
        ]
      }
    },
    {
      "width": "container",
      "height": 140,
      "mark": {
        "type": "circle",
        "size": 110
      },
      "encoding": {
        "x": {
          "field": "result_final_resource",
          "type": "quantitative",
          "title": "Resource remaining after the last harvest",
          "scale": {
            "zero": true
          },
          "axis": {
            "tickCount": 5
          }
        },
        "y": {
          "field": "param_experiment",
          "type": "nominal",
          "title": null,
          "axis": {
            "labelLimit": 130
          }
        },
        "color": {
          "field": "param_model",
          "type": "nominal",
          "title": "Model"
        },
        "opacity": {
          "condition": {
            "param": "chosen",
            "value": 0.85
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "run",
            "title": "Run"
          },
          {
            "field": "result_final_resource",
            "title": "Final resource"
          }
        ]
      }
    }
  ],
  "config": {
    "legend": {
      "orient": "bottom"
    }
  }
}
